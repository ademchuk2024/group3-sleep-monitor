# Files that should NOT go to GitHub

# The virtual environment (big, and each computer makes its own)
.venv/

# Python's temporary files
__pycache__/
*.pyc

# Mac Finder files
.DS_Store

# Never upload real recordings by accident (the sample file is allowed)
*.csv
!sample_data/sample_night.csv

# Downloaded research datasets (Walch, BIDSleep, Newcastle) and anything built
# from them. They are large, and their licenses and our privacy rules mean
# they must never be uploaded to GitHub. tests/test_repo_hygiene.py checks this.
data/

# Files pytest makes when it runs
.pytest_cache/
